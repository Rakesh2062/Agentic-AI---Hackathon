# ─── LLM / Gemini ──────────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-3.5-flash-lite

# ─── Embedding (used by RAG / Duplicate Detection) ──────────────────────────────
# Same key as LLM_API_KEY — can be identical value
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# ─── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Get connection string from: MongoDB Atlas → Cluster → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (leave as civic_platform unless you want a different name)
MONGODB_DB_NAME=civic_platform

# Connection pool settings (defaults work fine for most deployments)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_TIMEOUT_MS=5000

# ─── Optional: Google Maps ──────────────────────────────────────────────────────
# Required only for the interactive map location picker in the frontend
# Get key from: https://console.cloud.google.com → Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
